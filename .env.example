# คัดลอกเป็น .env.local (ไม่ต้อง commit)

# ที่อยู่ backend
#  - ปล่อยว่างไว้ (VITE_API_URL=) = เรียกที่โดเมนเดียวกับหน้าเว็บ ใช้คู่กับ proxy ใน vite.config.ts ตอนทดสอบ LIFF
#  - ไม่ตั้งเลย = http://localhost:3000
VITE_API_URL=http://localhost:3000

# LIFF ID จาก LINE Developers Console (แท็บ LIFF) ถ้าไม่ตั้งจะใช้หน้าล็อกอินทดสอบ
VITE_LIFF_ID=

# ตั้งเป็น true เพื่อกลับไปใช้ข้อมูลปลอม ไม่ต้องรัน backend
VITE_USE_MOCK=false
